! pythia8_mumu_fcc.cmnd
! ----------------------------------------------------------------------------
! Pythia8 steering for Stage 2 of the FCC-ee e+ e- -> mu+ mu- validation.
! Reads the parton-level LHE produced by MadGraph (Stage 1), applies the QED
! parton shower (FSR off the muons, ISR off the e+e- beams), and writes HepMC2
! for Delphes.
!
! Physics note: at sqrt(s)=240 GeV ISR can radiate O(alpha/pi) ~ 0.2% of beam
! energy per emission, slightly shifting the effective CM energy. The effect is
! small and acceptable for a pipeline smoke test.
!
! Run through the driver:  bash mc/shower_validation_mumu_fcc.sh
! ----------------------------------------------------------------------------

! --- Input: parton-level LHE from Stage 1 ---
Beams:frameType = 4
Beams:LHEF      = PROC_validation_mumu_fcc/Events/run_01/unweighted_events.lhe.gz

! --- Statistics ---
Main:numberOfEvents   = 10000
Main:numberOfSubruns  = 1
Main:subrun           = 0
Main:timesAllowErrors = 10

! --- Shower / underlying event ---
PartonLevel:MPI = off

! --- Robustness ---
Check:epTolErr = 2e-2
